#!/bin/sh
# Pre-push hook that runs all CI checks locally
# This prevents pushing code that will fail CI

# git writes one line per ref on stdin: local ref, local object id, remote
# ref, remote object id. A branch deletion has an all-zero local id and
# carries no files, so there is nothing to check.
pushes_commits=
while read -r _ local_oid _; do
  case "$local_oid" in
    *[!0]*) pushes_commits=1 ;;
  esac
done
if [ -z "$pushes_commits" ]; then
  echo "🔍 Nothing to check: this push only deletes branches."
  exit 0
fi

echo "🔍 Running pre-push checks..."
echo ""

CURRENT_BRANCH=$(git branch --show-current)
echo "📌 Branch: $CURRENT_BRANCH"
echo ""

set -e

# ensure deps are installed so checks like prettier are available
if [ ! -d node_modules ]; then
  echo "📦 Installing npm dependencies (npm ci)..."
  npm ci
fi

echo "1️⃣  Formatting check..."
npm run format:check
echo "✅ Formatting passed"
echo ""

echo "2️⃣  Spell check..."
npm run spellcheck
echo "✅ Spell check passed"
echo ""

echo "3️⃣  Markdown lint..."
npm run lint:markdown
echo "✅ Markdown lint passed"
echo ""

echo "4️⃣  Terminology..."
npm run lint:terminology
echo "✅ Terminology passed"
echo ""

echo "5️⃣  Model pins..."
npm run lint:model-pins
echo "✅ Model pins passed"
echo ""

echo "6️⃣  Eval request sizes..."
npm run lint:prompt-budget
echo "✅ Eval request sizes passed"
echo ""

echo "7️⃣  Eval tripwires..."
npm run lint:tripwires
echo "✅ Eval tripwires passed"
echo ""

echo "8️⃣  Validate skills..."
npm run validate:skills
echo "✅ Skills validation passed"
echo ""

echo "✨ All pre-push checks passed! Pushing..."
echo ""
