{
  "name": "@maplibre/agent-skills",
  "version": "0.1.0",
  "description": "Agent Skills for building MapLibre applications with open tile sources and open-source tooling",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{md,json,js}\"",
    "format:check": "node scripts/format-check.js",
    "spellcheck": "cspell \"*.md\" \"skills/**/*.md\"",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore node_modules",
    "validate:skills": "node scripts/validate-skills.js",
    "lint:terminology": "node scripts/terminology-check.js",
    "fix:terminology": "node scripts/terminology-fix.js",
    "lint:model-pins": "node scripts/model-pin-check.js",
    "eval": "promptfoo eval",
    "eval:graded": "promptfoo eval --grader google:gemini-2.5-flash-lite --delay 8000 --no-cache -j 1",
    "test": "node --test scripts/",
    "check:changelog-field": "node scripts/check-changelog-field.js",
    "generate:skills-table": "node scripts/generate-skills-table.js",
    "check": "npm run format:check && npm run spellcheck && npm run lint:markdown && npm run lint:terminology && npm run lint:model-pins && npm run validate:skills",
    "setup": "node scripts/setup-hooks.js",
    "postinstall": "node scripts/setup-hooks.js"
  },
  "keywords": [
    "agent-skills",
    "maplibre",
    "maplibre-gl-js",
    "open-source",
    "claude-code",
    "cursor",
    "copilot",
    "performance",
    "best-practices"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maplibre/maplibre-agent-skills.git"
  },
  "devDependencies": {
    "cspell": "^8.0.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.8.1",
    "promptfoo": "^0.122.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.3"
  }
}
